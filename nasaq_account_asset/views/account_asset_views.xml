<odoo>
    <!-- DIGITAL H1029: OCA's own menus stay; 'Funded by' on the form, the list and the search. -->
    <record id="account_asset_view_form_nasaq" model="ir.ui.view">
        <field name="name">account.asset.form.nasaq</field>
        <field name="model">account.asset</field>
        <field name="inherit_id" ref="account_asset_management.account_asset_view_form"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <!-- Set by hand only while it is empty and nothing is posted (the opening register) -->
                <field name="company_fund_plan_id" invisible="1"/>
                <field name="source_fund_id" readonly="source_fund_id" invisible="not company_fund_plan_id"
                       options="{'no_create': True}" groups="account.group_account_user,account.group_account_manager,account.group_account_invoice"/>
            </field>
        </field>
    </record>

    <record id="account_asset_view_tree_nasaq" model="ir.ui.view">
        <field name="name">account.asset.list.nasaq</field>
        <field name="model">account.asset</field>
        <field name="inherit_id" ref="account_asset_management.account_asset_view_tree"/>
        <field name="arch" type="xml">
            <field name="code" position="after">
                <field name="source_fund_id" optional="show"/>
            </field>
        </field>
    </record>

    <record id="account_asset_view_search_nasaq" model="ir.ui.view">
        <field name="name">account.asset.search.nasaq</field>
        <field name="model">account.asset</field>
        <field name="inherit_id" ref="account_asset_management.account_asset_view_search"/>
        <field name="arch" type="xml">
            <field name="profile_id" position="after">
                <field name="source_fund_id"/>
            </field>
            <group name="groupby" position="inside">
                <filter name="source_fund_groupby" string="Funded by" context="{'group_by': 'source_fund_id'}"/>
            </group>
        </field>
    </record>
</odoo>
