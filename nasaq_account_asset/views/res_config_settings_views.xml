<odoo>
    <record id="res_config_settings_view_form_asset_fund" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.asset.fund</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="inside">
                <block title="Fixed Assets and Restricted Funds" name="asset_fund">
                    <setting string="Funds plan for assets"
                             help="An asset bought on an account of this analytic plan records it as 'Funded by'. Its depreciation and disposal entries never carry it, so the fund is charged once, at purchase.">
                        <field name="asset_fund_plan_id"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
